{
  "name": "sdui-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/main/resources/static/tailwind.in.css -o ./src/main/resources/static/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/main/resources/static/tailwind.in.css -o ./src/main/resources/static/tailwind.css --watch",
    "watch:json": "onchange '**/*.json' -- npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "onchange": "^7.1.0",
    "tailwindcss": "^4.0.0"
  }
}
